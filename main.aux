\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textcolor {blue}{Concentration--mass relations for the PL, BT\_soft ($k_p=1\,h\,\mathrm  {Mpc}^{-1}$, $m_s=1.5$), and BT\_deep ($k_p=10\,h\,\mathrm  {Mpc}^{-1}$, $m_s=1.5$) models at four representative redshifts. Symbols show the simulation measurements and solid curves show the corresponding semi-analytic predictions. The lower panels give the concentration ratios relative to the PL model. At fixed mass, halos in the blue-tilted models are systematically more concentrated, with the strongest differences occurring in the low-mass regime.}}}{11}{figure.caption.30}\protected@file@percent }
\newlabel{fig:concentration_comparison}{{6}{11}{\blue {Concentration--mass relations for the PL, BT\_soft ($k_p=1\,h\,\mathrm {Mpc}^{-1}$, $m_s=1.5$), and BT\_deep ($k_p=10\,h\,\mathrm {Mpc}^{-1}$, $m_s=1.5$) models at four representative redshifts. Symbols show the simulation measurements and solid curves show the corresponding semi-analytic predictions. The lower panels give the concentration ratios relative to the PL model. At fixed mass, halos in the blue-tilted models are systematically more concentrated, with the strongest differences occurring in the low-mass regime.}}{figure.caption.30}{}}
