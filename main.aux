\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Summary of cosmological N-body simulation parameters. PL models use standard power-law power spectra, while Blue Tilted models have enhanced power on small scales. $k_p$ is the wavenumber where the power spectrum enhancement begins, $m_s$ is the spectral index (tilt slope), $N$ is the number of dark matter particles, Box size is the comoving side length of the simulation volume, $m_{\text  {DM}}$ is the dark matter particle mass, and $\epsilon $ is the gravitational softening length. All simulations use the same background cosmology with varying initial conditions to study the effects of small-scale power on structure formation.}}{3}{table.caption.11}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:simulation_parameters}{{I}{3}{Summary of cosmological N-body simulation parameters. PL models use standard power-law power spectra, while Blue Tilted models have enhanced power on small scales. $k_p$ is the wavenumber where the power spectrum enhancement begins, $m_s$ is the spectral index (tilt slope), $N$ is the number of dark matter particles, Box size is the comoving side length of the simulation volume, $m_{\text {DM}}$ is the dark matter particle mass, and $\epsilon $ is the gravitational softening length. All simulations use the same background cosmology with varying initial conditions to study the effects of small-scale power on structure formation}{table.caption.11}{}}
