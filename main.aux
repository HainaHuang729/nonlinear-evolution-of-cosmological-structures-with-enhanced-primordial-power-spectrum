\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces {\color  {blue}FOF halo mass functions for the PL, BT\_soft, and BT\_deep simulations at representative redshifts. Upper panels show the measured $dn/d\qopname  \relax o{log}_{10} M_{\rm  FOF}$ with Poisson error bars, together with the corresponding model-matched Reed07 FOF predictions evaluated with each input linear power spectrum. Lower panels show the direct BT\_soft/PL and BT\_deep/PL mass-function ratios in the same FOF mass bins. Here BT\_soft denotes the model with $k_p=1\,h\,{\rm  Mpc}^{-1}$ and $m_s=1.5$, while BT\_deep denotes the model with $k_p=10\,h\,{\rm  Mpc}^{-1}$ and $m_s=1.5$. All simulations use a $25\,h^{-1}{\rm  Mpc}$ box with $1024^3$ particles. The gray band marks the interval between the nominal 20-particle halo threshold \(3.8\times 10^7\,M_\odot \) and the adopted plotted catalog cut \(M_{\rm  FOF}=10^8\,M_\odot \), roughly the 50-particle scale. The corresponding spherical-overdensity $M_{200c}$ comparison with B16 is shown in Appendix\nobreakspace  {}\ref  {app:m200c_hmf}.}\relax }}{7}{figure.caption.19}\protected@file@percent }
\newlabel{fig:mass_function}{{3}{7}{{\color {blue}FOF halo mass functions for the PL, BT\_soft, and BT\_deep simulations at representative redshifts. Upper panels show the measured $dn/d\log _{10} M_{\rm FOF}$ with Poisson error bars, together with the corresponding model-matched Reed07 FOF predictions evaluated with each input linear power spectrum. Lower panels show the direct BT\_soft/PL and BT\_deep/PL mass-function ratios in the same FOF mass bins. Here BT\_soft denotes the model with $k_p=1\,h\,{\rm Mpc}^{-1}$ and $m_s=1.5$, while BT\_deep denotes the model with $k_p=10\,h\,{\rm Mpc}^{-1}$ and $m_s=1.5$. All simulations use a $25\,h^{-1}{\rm Mpc}$ box with $1024^3$ particles. The gray band marks the interval between the nominal 20-particle halo threshold \(3.8\times 10^7\,M_\odot \) and the adopted plotted catalog cut \(M_{\rm FOF}=10^8\,M_\odot \), roughly the 50-particle scale. The corresponding spherical-overdensity $M_{200c}$ comparison with B16 is shown in Appendix~\ref {app:m200c_hmf}.}\relax }{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces {\color  {blue}NFW-equivalent halo density profiles reconstructed from \textsc  {SOAP} \texttt  {SO/200\_mean} masses, radii, and concentrations for the PL, BT\_soft, and BT\_deep models. The solid lines labeled ``mean-\(c\) NFW'' use the mean concentration and radius of the halos in each mass bin to draw one NFW profile, whereas the open markers labeled ``median-\(c\) NFW'' show median profiles obtained by evaluating the same NFW form halo by halo from the catalog concentrations on a common \(r/R_{200}\) grid. The markers therefore do not denote individual halos. Radii are normalized by $R_{200}$, and each panel compares halos within a \(\pm 20\%\) interval around \(M_{200m}=10^8,10^9,10^{10},\) and \(10^{11}\,M_\odot \). The panel labels report the approximate particle count at the bin center, and the dashed vertical marker shows \(\epsilon _{\rm  Pl}/R_{200}\) when it lies inside the plotted radial range. For the main-run particle mass, these bin centers correspond approximately to 50, \(5\times 10^2\), \(5\times 10^3\), and \(5\times 10^4\) particles, respectively; the \(10^8\,M_\odot \) panel is therefore closest to the resolution boundary and is interpreted qualitatively. Because both the line and marker profiles are reconstructed from catalog concentrations rather than direct particle-count stacks, they should be read as concentration-based compactness diagnostics. In this NFW-equivalent reconstruction, the blue-tilted models exhibit higher central densities than PL, with the strongest effect appearing in the low- and intermediate-mass regimes.}\relax }}{7}{figure.caption.24}\protected@file@percent }
\newlabel{fig:halo_density_analysis}{{5}{7}{{\color {blue}NFW-equivalent halo density profiles reconstructed from \textsc {SOAP} \texttt {SO/200\_mean} masses, radii, and concentrations for the PL, BT\_soft, and BT\_deep models. The solid lines labeled ``mean-\(c\) NFW'' use the mean concentration and radius of the halos in each mass bin to draw one NFW profile, whereas the open markers labeled ``median-\(c\) NFW'' show median profiles obtained by evaluating the same NFW form halo by halo from the catalog concentrations on a common \(r/R_{200}\) grid. The markers therefore do not denote individual halos. Radii are normalized by $R_{200}$, and each panel compares halos within a \(\pm 20\%\) interval around \(M_{200m}=10^8,10^9,10^{10},\) and \(10^{11}\,M_\odot \). The panel labels report the approximate particle count at the bin center, and the dashed vertical marker shows \(\epsilon _{\rm Pl}/R_{200}\) when it lies inside the plotted radial range. For the main-run particle mass, these bin centers correspond approximately to 50, \(5\times 10^2\), \(5\times 10^3\), and \(5\times 10^4\) particles, respectively; the \(10^8\,M_\odot \) panel is therefore closest to the resolution boundary and is interpreted qualitatively. Because both the line and marker profiles are reconstructed from catalog concentrations rather than direct particle-count stacks, they should be read as concentration-based compactness diagnostics. In this NFW-equivalent reconstruction, the blue-tilted models exhibit higher central densities than PL, with the strongest effect appearing in the low- and intermediate-mass regimes.}\relax }{figure.caption.24}{}}
