\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces {\color  {blue}Half-mass assembly redshift $z_{1/2}$ as a function of final tree mass $M_0$ at $z=0$ for the PL, BT\_soft, and BT\_deep simulations. Points show individual halo measurements and the solid curves show the binned trend for each model, where $z_{1/2}$ is defined from the main progenitor branch of the merger tree. Halos in the blue-tilted models reach half of their final mass systematically earlier than their PL counterparts, especially at lower masses.}}}{3}{figure.caption.9}\protected@file@percent }
\newlabel{fig:half_mass_redshift}{{1}{3}{\color {blue}Half-mass assembly redshift $z_{1/2}$ as a function of final tree mass $M_0$ at $z=0$ for the PL, BT\_soft, and BT\_deep simulations. Points show individual halo measurements and the solid curves show the binned trend for each model, where $z_{1/2}$ is defined from the main progenitor branch of the merger tree. Halos in the blue-tilted models reach half of their final mass systematically earlier than their PL counterparts, especially at lower masses}{figure.caption.9}{}}
