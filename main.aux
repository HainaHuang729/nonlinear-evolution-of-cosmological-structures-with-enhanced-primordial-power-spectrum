\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces {\color  {blue}Projected dark matter density fields for the PL, BT\_soft, and BT\_deep simulations at $z=0$. All three runs use a periodic box of $25\,h^{-1}\,\mathrm  {Mpc}$ with $1024^3$ particles. The figure is used as a visual comparison of the dark matter field; quantitative claims in this paper are based on the halo mass function, assembly histories, density profiles, concentration--mass relation, and matter power spectrum rather than on projected substructure counts.}}}{6}{figure.caption.20}\protected@file@percent }
\newlabel{fig:dark_matter_comparison}{{3}{6}{\color {blue}Projected dark matter density fields for the PL, BT\_soft, and BT\_deep simulations at $z=0$. All three runs use a periodic box of $25\,h^{-1}\,\mathrm {Mpc}$ with $1024^3$ particles. The figure is used as a visual comparison of the dark matter field; quantitative claims in this paper are based on the halo mass function, assembly histories, density profiles, concentration--mass relation, and matter power spectrum rather than on projected substructure counts}{figure.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces {\color  {blue}FOF halo mass functions for the PL, BT\_soft, and BT\_deep simulations at representative redshifts. Symbols show the measured $dn/d\ln M_{\rm  FOF}$ with Poisson error bars, and lines show the corresponding model-matched Reed07 FOF predictions evaluated with each input linear power spectrum. Here BT\_soft denotes the model with $k_p=1\,h\,{\rm  Mpc}^{-1}$ and $m_s=1.5$, while BT\_deep denotes the model with $k_p=10\,h\,{\rm  Mpc}^{-1}$ and $m_s=1.5$. All simulations use a $25\,h^{-1}{\rm  Mpc}$ box with $1024^3$ particles. The corresponding spherical-overdensity $M_{200c}$ comparison with Bocquet16 is shown in Appendix~\ref {app:m200c_hmf}.}}}{7}{figure.caption.22}\protected@file@percent }
\newlabel{fig:mass_function}{{4}{7}{\color {blue}FOF halo mass functions for the PL, BT\_soft, and BT\_deep simulations at representative redshifts. Symbols show the measured $dn/d\ln M_{\rm FOF}$ with Poisson error bars, and lines show the corresponding model-matched Reed07 FOF predictions evaluated with each input linear power spectrum. Here BT\_soft denotes the model with $k_p=1\,h\,{\rm Mpc}^{-1}$ and $m_s=1.5$, while BT\_deep denotes the model with $k_p=10\,h\,{\rm Mpc}^{-1}$ and $m_s=1.5$. All simulations use a $25\,h^{-1}{\rm Mpc}$ box with $1024^3$ particles. The corresponding spherical-overdensity $M_{200c}$ comparison with Bocquet16 is shown in Appendix~\ref {app:m200c_hmf}}{figure.caption.22}{}}
