\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces {\color  {blue}Concentration--mass relations for the PL, BT\_soft ($k_p=1\,h\,\mathrm  {Mpc}^{-1}$, $m_s=1.5$), and BT\_deep ($k_p=10\,h\,\mathrm  {Mpc}^{-1}$, $m_s=1.5$) models at four representative redshifts. Symbols show the simulation measurements and solid curves show the corresponding semi-analytic predictions. The lower panels give the concentration ratios relative to the PL model. At $z=0$, the median concentration in the $10^9$--$10^{9.5}\,M_\odot $ bin is higher than PL by factors of $3.20$ and $1.35$ for the $k_p=1$ and $k_p=10$ runs, respectively.}}}{10}{figure.caption.28}\protected@file@percent }
\newlabel{fig:concentration_comparison}{{6}{10}{\color {blue}Concentration--mass relations for the PL, BT\_soft ($k_p=1\,h\,\mathrm {Mpc}^{-1}$, $m_s=1.5$), and BT\_deep ($k_p=10\,h\,\mathrm {Mpc}^{-1}$, $m_s=1.5$) models at four representative redshifts. Symbols show the simulation measurements and solid curves show the corresponding semi-analytic predictions. The lower panels give the concentration ratios relative to the PL model. At $z=0$, the median concentration in the $10^9$--$10^{9.5}\,M_\odot $ bin is higher than PL by factors of $3.20$ and $1.35$ for the $k_p=1$ and $k_p=10$ runs, respectively}{figure.caption.28}{}}
