\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces {\color  {blue}FOF halo mass functions for the PL, BT\_soft, and BT\_deep simulations at representative redshifts. Symbols show the measured $dn/d\ln M_{\rm  FOF}$ with Poisson error bars, and lines show the corresponding model-matched Reed07 FOF predictions evaluated with each input linear power spectrum. Here BT\_soft denotes the model with $k_p=1\,h\,{\rm  Mpc}^{-1}$ and $m_s=1.5$, while BT\_deep denotes the model with $k_p=10\,h\,{\rm  Mpc}^{-1}$ and $m_s=1.5$. All simulations use a $25\,h^{-1}{\rm  Mpc}$ box with $1024^3$ particles. The corresponding spherical-overdensity $M_{200c}$ comparison with Bocquet16 is shown in Appendix~\ref {app:m200c_hmf}.}}}{6}{figure.caption.21}\protected@file@percent }
\newlabel{fig:mass_function}{{3}{6}{\color {blue}FOF halo mass functions for the PL, BT\_soft, and BT\_deep simulations at representative redshifts. Symbols show the measured $dn/d\ln M_{\rm FOF}$ with Poisson error bars, and lines show the corresponding model-matched Reed07 FOF predictions evaluated with each input linear power spectrum. Here BT\_soft denotes the model with $k_p=1\,h\,{\rm Mpc}^{-1}$ and $m_s=1.5$, while BT\_deep denotes the model with $k_p=10\,h\,{\rm Mpc}^{-1}$ and $m_s=1.5$. All simulations use a $25\,h^{-1}{\rm Mpc}$ box with $1024^3$ particles. The corresponding spherical-overdensity $M_{200c}$ comparison with Bocquet16 is shown in Appendix~\ref {app:m200c_hmf}}{figure.caption.21}{}}
\citation{Diemer2018}
\citation{Diemer2019,Ishiyama2021}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces {\color  {blue}Half-mass assembly redshift $z_{1/2}$ as a function of final tree mass $M_0$ at $z=0$ for the PL, BT\_soft, and BT\_deep simulations. Points show individual halo measurements and the solid curves show the binned trend for each model, where $z_{1/2}$ is defined from the main progenitor branch of the merger tree. Halos in the blue-tilted models reach half of their final mass systematically earlier than their PL counterparts, especially at lower masses.}}}{7}{figure.caption.23}\protected@file@percent }
\newlabel{fig:half_mass_redshift}{{4}{7}{\color {blue}Half-mass assembly redshift $z_{1/2}$ as a function of final tree mass $M_0$ at $z=0$ for the PL, BT\_soft, and BT\_deep simulations. Points show individual halo measurements and the solid curves show the binned trend for each model, where $z_{1/2}$ is defined from the main progenitor branch of the merger tree. Halos in the blue-tilted models reach half of their final mass systematically earlier than their PL counterparts, especially at lower masses}{figure.caption.23}{}}
\newlabel{subsub:concentration}{{IV\,D\,2}{7}{}{section*.27}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {2}Concentration-Mass Relation}{7}{section*.27}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces {\color  {blue}Stacked halo density profiles for the PL, BT\_soft, and BT\_deep models in a sequence of halo-mass bins. Radii are normalized by $R_{200}$, and each panel compares halos within a narrow mass interval. Relative to PL, the blue-tilted models exhibit higher central densities, with the strongest effect appearing in the low- and intermediate-mass regimes.}}}{8}{figure.caption.26}\protected@file@percent }
\newlabel{fig:halo_density_analysis}{{5}{8}{\color {blue}Stacked halo density profiles for the PL, BT\_soft, and BT\_deep models in a sequence of halo-mass bins. Radii are normalized by $R_{200}$, and each panel compares halos within a narrow mass interval. Relative to PL, the blue-tilted models exhibit higher central densities, with the strongest effect appearing in the low- and intermediate-mass regimes}{figure.caption.26}{}}
