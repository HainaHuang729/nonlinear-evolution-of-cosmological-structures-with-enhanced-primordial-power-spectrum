\@writefile{toc}{\contentsline {title}{The Impact of Enhanced Small-Scale Primordial Matter Power Spectrum on Nonlinear Structure Formation}{1}{section*.7}\protected@file@percent }
\@writefile{toc}{\contentsline {abstract}{Abstract}{1}{section*.1}\protected@file@percent }
\@writefile{loc}{\contentsline {replaced}{Replaced~(rev): \truncate {\Changestruncatewidth }{The small-scale shape of the primordial power spectrum is still weakly constrained. If primordial power is enhanced on these scales, small-scale density fluctuations can collapse earlier and change the abundance and internal structure of dark matter halos. We test this effect with dark-matter-only cosmological \(N\)-body simulations. Using matched initial phases, we compare a standard power-law model with two blue-tilted benchmark models, in which the small-scale power is enhanced above a pivot wavenumber \(k_p\). We measure halo mass functions, assembly histories, concentration--mass relations, and the nonlinear matter power spectrum.}}{1}{section*.2}\protected@file@percent }
\@writefile{toc}{\contentsline {abstract}{Abstract}{1}{section*.3}\protected@file@percent }
\@writefile{loc}{\contentsline {replaced}{Replaced~(rev): \truncate {\Changestruncatewidth }{The model with \(k_p=1\,h\,{\rm  Mpc}^{-1}\) and \(m_s=1.5\), which we call BT\_soft, gives the largest response. Its FOF halo abundance is higher than in the power-law model by factors of \(4.8\)--\(6.6\) at \(z=8.52\) over \(M_{\rm  FOF}\simeq 1.2\times 10^9\)--\(1.2\times 10^{10}\,M_\odot \), and by \(1.4\)--\(1.5\) at \(z=0\) over the same mass range. Halo assembly also shifts earlier: near \(M_{z=0}\simeq 1.25\times 10^9\,M_\odot \), the half-mass redshift \(z_{1/2}\) increases from \(2.28\) in the power-law model to \(4.24\) in BT\_soft. At \(z=0\), the median concentration in the \(10^9\)--\(10^{9.5}\,M_\odot \) bin is higher by a factor of \(3.20\). The nonlinear matter power spectrum changes less strongly, with \(P_{\rm  BT}/P_{\rm  PL}=1.17\) at \(k=20\,h\,{\rm  Mpc}^{-1}\) and \(1.34\) at \(k=40\,h\,{\rm  Mpc}^{-1}\).}}{1}{section*.4}\protected@file@percent }
\@writefile{toc}{\contentsline {abstract}{Abstract}{1}{section*.5}\protected@file@percent }
\@writefile{loc}{\contentsline {replaced}{Replaced~(rev): \truncate {\Changestruncatewidth }{These results show that enhanced small-scale primordial power has its clearest effect on low-mass halos and on the nonlinear matter power spectrum at small scales, with a response that depends on pivot scale and redshift. The simulations provide benchmarks for how dark matter halos respond to enhanced small-scale primordial power, which can be compared in later work with high-redshift galaxies, dwarf galaxies, strong lensing, and 21 cm measurements.}}{1}{section*.6}\protected@file@percent }
\newlabel{intro}{{I}{1}{}{section*.8}{}}
\@writefile{toc}{\contentsline {section}{\numberline {I}Introduction}{1}{section*.8}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added~(rev): \truncate {\Changestruncatewidth }{On large scales, the standard \(\Lambda \) Cold Dark Matter (\(\Lambda \)CDM) model with a nearly power-law primordial power spectrum agrees well with measurements of the cosmic microwave background, galaxy clustering, and the Lyman-\(\alpha \) forest \citep  {Planck20CMB,Blanton17SDSSsurvey,Chabanier19LyalphaPS}. On smaller scales, the shape of the primordial power spectrum is less tightly measured. Earlier small-scale problems, such as the missing-satellites, core-cusp, and too-big-to-fail problems, motivated tests of departures from the simplest cold-dark-matter picture \citep  {Bullock17smallscalechallenges,Sales22challenges}. These problems are difficult to interpret on their own because baryonic physics can change the same observables \citep  {Benson2002reionization,Chan2015corecusp}.}}{1}{section*.9}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added~(rev): \truncate {\Changestruncatewidth }{The recent JWST discovery of abundant and potentially massive galaxy candidates at \(z\gtrsim 8\)--\(10\) has renewed interest in the small-scale primordial power spectrum \citep  {Labbe23MassiveGalaxies,Donnan23UVLF}. One possible explanation is enhanced small-scale primordial power, which can make low-mass halos form earlier \citep  {Parashari23JWSTPPS,Hira24bluetilt}. This is not the only explanation: high-redshift galaxy formation, dust, feedback, star-formation efficiency, UV emission efficiency, and selection effects can also affect the observed galaxy counts \citep  {Lovell23JWSTExtreme}.}}{1}{section*.10}\protected@file@percent }
\citation{Hirano15BlueTiltedPPS,Parashari23JWSTPPS,Hira24bluetilt,Tkac24BumpyPPS,deKruijf25DarkAges,Dekker25DwarfPPS,Wu25BT}
\citation{Parashari23JWSTPPS,Hira24bluetilt}
\citation{Wu25BT}
\citation{Kim18nomissingsatellites,Dekker25DwarfPPS,Gilman22SubgalacticPPS,Munoz20SmallScale21cm,deKruijf25DarkAges,Zhu26SKAPPS}
\citation{Wu25BT}
\citation{Planck20CMB}
\citation{Hira24bluetilt,Dekker25DwarfPPS}
\@writefile{loc}{\contentsline {added}{Added~(rev): \truncate {\Changestruncatewidth }{Several theoretical models can produce enhanced small-scale power. Warm inflation can amplify curvature perturbations \citep  {Arya20WarmInflation}. Axion models with curved field-space effects can produce blue spectra \citep  {Sai26BlueTilt}, and multi-field or hybrid inflation models can produce broken-power-law enhancements \citep  {Linde94Hybridinflation,Wang24BTinflationtheory,Wang25HybridInflation}. A population of primordial black holes (PBHs) can also add small-scale matter power through Poisson fluctuations, which act as an isocurvature component \citep  {Inman2019PBHBT}. We do not model these mechanisms separately. Instead, we use the blue-tilted spectra as simple benchmarks for testing how dark matter structure responds to enhanced small-scale primordial power.}}{2}{section*.11}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added~(rev): \truncate {\Changestruncatewidth }{Following previous literature \citep  [e.g.][]{Hirano15BlueTiltedPPS,Parashari23JWSTPPS,Hira24bluetilt,Tkac24BumpyPPS,deKruijf25DarkAges,Dekker25DwarfPPS,Wu25BT}, we call these models ``blue-tilted'' (BT) because their small-scale slope is steeper than the usual power-law slope. Below a pivot wavenumber \(k_p\), the primordial power-spectrum template follows the standard PL shape. Above \(k_p\), the slope changes to \(m_s\), with \(m_s>n_s\), so the model has more power at larger \(k\), or smaller physical scales. In this paper the BT spectra are phenomenological benchmarks, not direct fits to a specific inflation model.}}{2}{section*.12}\protected@file@percent }
\@writefile{loc}{\contentsline {replaced}{Replaced~(rev): \truncate {\Changestruncatewidth }{JWST-oriented studies ask whether enhanced small-scale primordial power can increase early galaxy abundances}}{2}{section*.13}\protected@file@percent }
\@writefile{loc}{\contentsline {replaced}{Replaced~(rev): \truncate {\Changestruncatewidth }{Other studies motivate complementary probes from dwarf-galaxy densities, satellite statistics, sub-galactic strong lensing, and 21 cm observations}}{2}{section*.14}\protected@file@percent }
\@writefile{loc}{\contentsline {replaced}{Replaced~(rev): \truncate {\Changestruncatewidth }{Interpreting those probes requires astrophysical and observational modeling, so they do not by themselves isolate the dark-matter halo response to}}{2}{section*.15}\protected@file@percent }
\@writefile{loc}{\contentsline {replaced}{Replaced~(rev): \truncate {\Changestruncatewidth }{a change in the small-scale primordial power spectrum}}{2}{section*.16}\protected@file@percent }
\@writefile{loc}{\contentsline {replaced}{Replaced~(rev): \truncate {\Changestruncatewidth }{enhancements in the small-scale primordial power spectrum}}{2}{section*.17}\protected@file@percent }
\@writefile{loc}{\contentsline {replaced}{Replaced~(rev): \truncate {\Changestruncatewidth }{comparing a standard power-law primordial power spectrum with two BT primordial power-spectrum templates and generating matched initial conditions from the corresponding linear matter spectra}}{2}{section*.18}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added~(rev): \truncate {\Changestruncatewidth }{The rest of this paper is organized as follows. Section~\ref {sec:theory} defines the PL and BT primordial power-spectrum templates and their corresponding input linear matter power spectra at \(z_i=200\). Section~\ref {sec:numerical} describes the initial conditions, simulations, halo catalogs, and analysis choices. Section~\ref {sec:results} presents the halo mass function, assembly-redshift, concentration, and nonlinear matter-power results. Section~\ref {sec:discussion} discusses the physical interpretation, numerical limitations, and links to observations. Section~\ref {sec:conclusion} summarizes the main quantitative findings.}}{2}{section*.19}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {II}Theoretical Overview}{2}{section*.20}\protected@file@percent }
\newlabel{sec:theory}{{II}{2}{}{section*.20}{}}
\@writefile{loc}{\contentsline {replaced}{Replaced~(rev): \truncate {\Changestruncatewidth }{the shape of the primordial power spectrum}}{2}{section*.21}\protected@file@percent }
\@writefile{loc}{\contentsline {replaced}{Replaced~(rev): \truncate {\Changestruncatewidth }{the PL and BT primordial power-spectrum templates and the corresponding input linear matter power spectra used for the initial conditions}}{2}{section*.22}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added~(rev): \truncate {\Changestruncatewidth }{We use two terminology levels throughout the paper. ``Primordial power spectrum'' refers to the phenomenological early-Universe template in Eq.~\ref {eq:bt_input_power}; when emphasizing the seeded matter fluctuations, we occasionally use ``primordial matter power spectrum'' in the same descriptive sense. ``Input linear matter power spectrum at \(z_i=200\)'' refers to the spectrum actually passed to \textsc  {Music2-MonofonIC} after applying the transfer-function implementation and the shared normalization.}}{2}{section*.23}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {A}From Matter Power Spectrum to Cosmic Structure}{2}{section*.24}\protected@file@percent }
\@writefile{loc}{\contentsline {replaced}{Replaced~(rev): \truncate {\Changestruncatewidth }{We model small-scale enhancements with blue-tilted (BT) primordial power-spectrum templates \citep  [e.g.][]{Hira24bluetilt,Dekker25DwarfPPS}. In these templates, the spectrum follows the PL form up to \(k_p\) and becomes steeper above \(k_p\):}}{2}{section*.25}\protected@file@percent }
\newlabel{eq:bt_input_power}{{1}{2}{}{equation.1}{}}
