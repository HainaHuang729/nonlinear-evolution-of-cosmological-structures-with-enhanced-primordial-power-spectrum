\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces {\color  {blue}Projected dark matter density fields for the PL, BT\_soft, and BT\_deep simulations at $z=0$. All three runs use a periodic box of $25\,h^{-1}\,\mathrm  {Mpc}$ with $1024^3$ particles, \(m_{\rm  DM}=1.89\times 10^6\,M_\odot \), and \(\epsilon _{\rm  Pl}=0.725\,\mathrm  {kpc}\) at $z=0$. No halo-particle cut is applied to this projection. The figure is used as a visual comparison of the dark matter field; quantitative claims in this paper are based on the halo mass function, assembly histories, concentration-based structural diagnostics, and matter power spectrum rather than on projected substructure counts.}\relax }}{5}{figure.caption.17}\protected@file@percent }
\newlabel{fig:dark_matter_comparison}{{2}{5}{{\color {blue}Projected dark matter density fields for the PL, BT\_soft, and BT\_deep simulations at $z=0$. All three runs use a periodic box of $25\,h^{-1}\,\mathrm {Mpc}$ with $1024^3$ particles, \(m_{\rm DM}=1.89\times 10^6\,M_\odot \), and \(\epsilon _{\rm Pl}=0.725\,\mathrm {kpc}\) at $z=0$. No halo-particle cut is applied to this projection. The figure is used as a visual comparison of the dark matter field; quantitative claims in this paper are based on the halo mass function, assembly histories, concentration-based structural diagnostics, and matter power spectrum rather than on projected substructure counts.}\relax }{figure.caption.17}{}}
