\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces FOF halo mass functions for the PL, BT\_soft, and BT\_deep simulations at representative redshifts. Upper panels show the measured $dn/d\log _{10} M_{\rm  FOF}$ with Poisson error bars, together with the corresponding model-matched Reed et al. (2007) (Reed07) FOF predictions evaluated with each linear matter power spectrum generated from the PL or BT primordial power-spectrum template. Lower panels show BT\_soft/PL and BT\_deep/PL mass-function ratios in the same FOF mass bins. Here BT\_soft denotes the model with $k_p=1\,h\,{\rm  Mpc}^{-1}$ and $m_s=1.5$, while BT\_deep denotes the model with $k_p=10\,h\,{\rm  Mpc}^{-1}$ and $m_s=1.5$. All simulations use a $25\,h^{-1}{\rm  Mpc}$ box with $1024^3$ particles. The gray band marks the interval between the nominal 20-particle halo threshold \(3.8\times 10^7\,M_\odot \) and the adopted plotted catalog cut \(M_{\rm  FOF}=10^8\,M_\odot \), roughly the 50-particle scale. The corresponding spherical-overdensity $M_{200c}$ comparison with Bocquet et al. (2016) is shown in Fig.~\ref {fig:m200c_bocquet16_hmf}.}}{7}{figure.3}\protected@file@percent }
\newlabel{fig:mass_function}{{3}{7}{FOF halo mass functions for the PL, BT\_soft, and BT\_deep simulations at representative redshifts. Upper panels show the measured $dn/d\log _{10} M_{\rm FOF}$ with Poisson error bars, together with the corresponding model-matched Reed et al. (2007) (Reed07) FOF predictions evaluated with each linear matter power spectrum generated from the PL or BT primordial power-spectrum template. Lower panels show BT\_soft/PL and BT\_deep/PL mass-function ratios in the same FOF mass bins. Here BT\_soft denotes the model with $k_p=1\,h\,{\rm Mpc}^{-1}$ and $m_s=1.5$, while BT\_deep denotes the model with $k_p=10\,h\,{\rm Mpc}^{-1}$ and $m_s=1.5$. All simulations use a $25\,h^{-1}{\rm Mpc}$ box with $1024^3$ particles. The gray band marks the interval between the nominal 20-particle halo threshold \(3.8\times 10^7\,M_\odot \) and the adopted plotted catalog cut \(M_{\rm FOF}=10^8\,M_\odot \), roughly the 50-particle scale. The corresponding spherical-overdensity $M_{200c}$ comparison with Bocquet et al. (2016) is shown in Fig.~\ref {fig:m200c_bocquet16_hmf}}{figure.3}{}}
\citation{Diemer2019}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Spherical-overdensity halo mass function comparison using \(M_{200c}\) masses and the Bocquet et al. (2016) (B16) fitting function. Symbols show the measured SOAP \(M_{200c}\) mass functions for PL, BT\_soft, and BT\_deep, while lines show the corresponding Bocquet et al. (2016) predictions evaluated with each model's linear matter power spectrum generated from the PL or BT primordial power-spectrum template. The SOAP catalog cut is \(N_{\rm  DM}\ge 100\), and the plotted bins require \(M_{200c}\ge 2.0\times 10^8\,M_\odot \), close to the 100-particle scale \(1.9\times 10^8\,M_\odot \). The gray band marks the low-mass region below this plotted completeness cut. The lower panels show BT\_soft/PL and BT\_deep/PL mass-function ratios in the same \(M_{200c}\) bins.}}{8}{figure.4}\protected@file@percent }
\newlabel{fig:m200c_bocquet16_hmf}{{4}{8}{Spherical-overdensity halo mass function comparison using \(M_{200c}\) masses and the Bocquet et al. (2016) (B16) fitting function. Symbols show the measured SOAP \(M_{200c}\) mass functions for PL, BT\_soft, and BT\_deep, while lines show the corresponding Bocquet et al. (2016) predictions evaluated with each model's linear matter power spectrum generated from the PL or BT primordial power-spectrum template. The SOAP catalog cut is \(N_{\rm DM}\ge 100\), and the plotted bins require \(M_{200c}\ge 2.0\times 10^8\,M_\odot \), close to the 100-particle scale \(1.9\times 10^8\,M_\odot \). The gray band marks the low-mass region below this plotted completeness cut. The lower panels show BT\_soft/PL and BT\_deep/PL mass-function ratios in the same \(M_{200c}\) bins}{figure.4}{}}
