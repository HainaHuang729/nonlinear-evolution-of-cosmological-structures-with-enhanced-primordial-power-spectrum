\@writefile{loc}{\contentsline {replaced}{Replaced~(rev): \truncate {\Changestruncatewidth }{The PL and BT initial conditions use the same target normalization, \(\sigma _8 = 0.8111\).}}{3}{section*.33}\protected@file@percent }
\@writefile{loc}{\contentsline {replaced}{Replaced~(rev): \truncate {\Changestruncatewidth }{The BT spectra are not assigned separately fitted \(\sigma _8\) values. They use the same background cosmology and target \(\sigma _8\) normalization as PL. MonofonIC then applies the required global normalization to each generated spectrum. The BT prescription changes the spectral shape for \(k>k_p\); below \(k_p\), the transfer-function shape remains the PL/Eisenstein shape, apart from the small global renormalization needed to enforce the same target \(\sigma _8\).}}{3}{section*.34}\protected@file@percent }
\@writefile{loc}{\contentsline {deleted}{Deleted~(rev): \truncate {\Changestruncatewidth }{The previous draft placed the PL, BT\_soft, and BT\_deep input-power parameters in a separate table, listing only \(k_p\) and \(m_s\).}}{3}{section*.35}\protected@file@percent }
\@writefile{loc}{\contentsline {added}{Added~(rev): \truncate {\Changestruncatewidth }{These model parameters are now listed together with the numerical simulation parameters in Table~\ref {tab:simulation_parameters}.}}{3}{section*.36}\protected@file@percent }
