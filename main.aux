\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces {\color  {blue}Concentration--mass relations for the PL, BT\_soft ($k_p=1\,h\,\mathrm  {Mpc}^{-1}$, $m_s=1.5$), and BT\_deep ($k_p=10\,h\,\mathrm  {Mpc}^{-1}$, $m_s=1.5$) models at four representative redshifts. Symbols show the simulation measurements and solid curves show the corresponding semi-analytic predictions. The lower panels give the concentration ratios relative to the PL model. At $z=0$, the median concentration in the $10^9$--$10^{9.5}\,M_\odot $ bin is higher than PL by factors of $3.20$ and $1.35$ for the $k_p=1$ and $k_p=10$ runs, respectively.}}}{11}{figure.caption.28}\protected@file@percent }
\newlabel{fig:concentration_comparison}{{6}{11}{\color {blue}Concentration--mass relations for the PL, BT\_soft ($k_p=1\,h\,\mathrm {Mpc}^{-1}$, $m_s=1.5$), and BT\_deep ($k_p=10\,h\,\mathrm {Mpc}^{-1}$, $m_s=1.5$) models at four representative redshifts. Symbols show the simulation measurements and solid curves show the corresponding semi-analytic predictions. The lower panels give the concentration ratios relative to the PL model. At $z=0$, the median concentration in the $10^9$--$10^{9.5}\,M_\odot $ bin is higher than PL by factors of $3.20$ and $1.35$ for the $k_p=1$ and $k_p=10$ runs, respectively}{figure.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces {\color  {blue}Nonlinear matter power spectra at $z=0$ for the PL and blue-tilted simulation products used in this analysis. The upper panel shows the dimensionless power spectrum $\Delta ^2(k)$, while the lower panels give ratios relative to PL. For the $k_p=1$ comparison in the fiducial $25\,h^{-1}\,\mathrm  {Mpc}$ box, the ratio is close to unity at $k\lesssim 2\,h\,\mathrm  {Mpc}^{-1}$ and rises to $1.17$ at $k=20\,h\,\mathrm  {Mpc}^{-1}$ and $1.34$ at $k=40\,h\,\mathrm  {Mpc}^{-1}$.}}}{12}{figure.caption.30}\protected@file@percent }
\newlabel{fig:power_spectra_ratio_z0}{{7}{12}{\color {blue}Nonlinear matter power spectra at $z=0$ for the PL and blue-tilted simulation products used in this analysis. The upper panel shows the dimensionless power spectrum $\Delta ^2(k)$, while the lower panels give ratios relative to PL. For the $k_p=1$ comparison in the fiducial $25\,h^{-1}\,\mathrm {Mpc}$ box, the ratio is close to unity at $k\lesssim 2\,h\,\mathrm {Mpc}^{-1}$ and rises to $1.17$ at $k=20\,h\,\mathrm {Mpc}^{-1}$ and $1.34$ at $k=40\,h\,\mathrm {Mpc}^{-1}$}{figure.caption.30}{}}
