\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces {\color  {blue}Summary of cosmological $N$-body simulation parameters. The main comparison uses only the PL, BT\_soft, and BT\_deep $25\,h^{-1}\mathrm  {Mpc}$, $1024^3$ runs. Additional BT variants are not used to support the main quantitative claims unless explicitly stated. The PL resolution and volume runs provide numerical checks. Here $k_p$ is reported in $h\,\mathrm  {Mpc}^{-1}$, $m_s$ is the small-scale spectral index, $m_{\text  {DM}}$ is measured from the snapshot mass table, and $\epsilon _{\rm  Pl}$ is the Plummer-equivalent softening length in physical kpc at $z=0$.}\relax }}{4}{table.2}\protected@file@percent }
\newlabel{tab:simulation_parameters}{{II}{4}{{\color {blue}Summary of cosmological $N$-body simulation parameters. The main comparison uses only the PL, BT\_soft, and BT\_deep $25\,h^{-1}\mathrm {Mpc}$, $1024^3$ runs. Additional BT variants are not used to support the main quantitative claims unless explicitly stated. The PL resolution and volume runs provide numerical checks. Here $k_p$ is reported in $h\,\mathrm {Mpc}^{-1}$, $m_s$ is the small-scale spectral index, $m_{\text {DM}}$ is measured from the snapshot mass table, and $\epsilon _{\rm Pl}$ is the Plummer-equivalent softening length in physical kpc at $z=0$.}\relax }{table.2}{}}
