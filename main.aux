\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces {\color  {blue}Half-mass assembly redshift $z_{1/2}$ as a function of final FOF mass $M_{\rm  FOF}$ at $z=0$ for the PL, BT\_soft, and BT\_deep simulations. The points use the same-TrackId diagnostic with all intermediate gaps filled and a cumulative mass envelope before evaluating the half-mass crossing. Error bars show the 16th--84th percentile halo-to-halo range in each mass bin. The black and gray curves show the BK09 and COCO/Hellwing16 reference relations, respectively \citep  {BoylanKolchin2009MSII,Hellwing16cocoproject}; the lower panel shows the difference relative to BK09. The HBT+ catalogs retain halos with at least 20 particles, corresponding to \(M\simeq 3.8\times 10^7\,M_\odot \) in the main runs; the quoted low-mass trends near \(10^9\,M_\odot \) are therefore based on halos with \(\gtrsim 5\times 10^2\) particles at $z=0$. The diagnostic shows earlier assembly in the blue-tilted models, with the strongest shift in BT\_soft.}}}{7}{figure.caption.21}\protected@file@percent }
\newlabel{fig:half_mass_redshift}{{4}{7}{\color {blue}Half-mass assembly redshift $z_{1/2}$ as a function of final FOF mass $M_{\rm FOF}$ at $z=0$ for the PL, BT\_soft, and BT\_deep simulations. The points use the same-TrackId diagnostic with all intermediate gaps filled and a cumulative mass envelope before evaluating the half-mass crossing. Error bars show the 16th--84th percentile halo-to-halo range in each mass bin. The black and gray curves show the BK09 and COCO/Hellwing16 reference relations, respectively \citep {BoylanKolchin2009MSII,Hellwing16cocoproject}; the lower panel shows the difference relative to BK09. The HBT+ catalogs retain halos with at least 20 particles, corresponding to \(M\simeq 3.8\times 10^7\,M_\odot \) in the main runs; the quoted low-mass trends near \(10^9\,M_\odot \) are therefore based on halos with \(\gtrsim 5\times 10^2\) particles at $z=0$. The diagnostic shows earlier assembly in the blue-tilted models, with the strongest shift in BT\_soft}{figure.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces {\color  {blue}NFW-equivalent halo density profiles reconstructed from \textsc  {SOAP} \texttt  {SO/200\_mean} masses, radii, and concentrations for the PL, BT\_soft, and BT\_deep models. The solid lines labeled ``mean-\(c\) NFW'' use the mean concentration and radius of the halos in each mass bin to draw one NFW profile, whereas the open markers labeled ``median-\(c\) NFW'' show median profiles obtained by evaluating the same NFW form halo by halo from the catalog concentrations on a common \(r/R_{200}\) grid. The markers therefore do not denote individual halos. Radii are normalized by $R_{200}$, and each panel compares halos within a \(\pm 20\%\) interval around \(M_{200m}=10^8,10^9,10^{10},\) and \(10^{11}\,M_\odot \). The panel labels report the approximate particle count at the bin center, and the dashed vertical marker shows \(\epsilon _{\rm  Pl}/R_{200}\) when it lies inside the plotted radial range. For the main-run particle mass, these bin centers correspond approximately to 50, \(5\times 10^2\), \(5\times 10^3\), and \(5\times 10^4\) particles, respectively; the \(10^8\,M_\odot \) panel is therefore closest to the resolution boundary and is interpreted qualitatively. Because both the line and marker profiles are reconstructed from catalog concentrations rather than direct particle-count stacks, they should be read as concentration-based compactness diagnostics. In this NFW-equivalent reconstruction, the blue-tilted models exhibit higher central densities than PL, with the strongest effect appearing in the low- and intermediate-mass regimes.}}}{7}{figure.caption.24}\protected@file@percent }
\newlabel{fig:halo_density_analysis}{{5}{7}{\color {blue}NFW-equivalent halo density profiles reconstructed from \textsc {SOAP} \texttt {SO/200\_mean} masses, radii, and concentrations for the PL, BT\_soft, and BT\_deep models. The solid lines labeled ``mean-\(c\) NFW'' use the mean concentration and radius of the halos in each mass bin to draw one NFW profile, whereas the open markers labeled ``median-\(c\) NFW'' show median profiles obtained by evaluating the same NFW form halo by halo from the catalog concentrations on a common \(r/R_{200}\) grid. The markers therefore do not denote individual halos. Radii are normalized by $R_{200}$, and each panel compares halos within a \(\pm 20\%\) interval around \(M_{200m}=10^8,10^9,10^{10},\) and \(10^{11}\,M_\odot \). The panel labels report the approximate particle count at the bin center, and the dashed vertical marker shows \(\epsilon _{\rm Pl}/R_{200}\) when it lies inside the plotted radial range. For the main-run particle mass, these bin centers correspond approximately to 50, \(5\times 10^2\), \(5\times 10^3\), and \(5\times 10^4\) particles, respectively; the \(10^8\,M_\odot \) panel is therefore closest to the resolution boundary and is interpreted qualitatively. Because both the line and marker profiles are reconstructed from catalog concentrations rather than direct particle-count stacks, they should be read as concentration-based compactness diagnostics. In this NFW-equivalent reconstruction, the blue-tilted models exhibit higher central densities than PL, with the strongest effect appearing in the low- and intermediate-mass regimes}{figure.caption.24}{}}
