\@writefile{toc}{\contentsline {section}{\numberline {A}FOF Mass-Function Resolution and Volume Check}{17}{section*.29}\protected@file@percent }
\newlabel{app:fof_hmf_resolution}{{A}{17}{}{section*.29}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces FOF halo-mass-function resolution and volume check for the PL simulations. Upper panels show the Warren-corrected FOF mass functions at \(z=0\) and \(z=8.52\) for the fiducial PL-25-\(1024^3\) run, same-volume lower-resolution PL-25-\(512^3\) and PL-25-\(256^3\) runs, and the larger PL-50-\(512^3\) run. Lower panels show ratios to PL-25-\(1024^3\) in the same mass bins. Vertical dotted lines mark the 50-particle FOF mass for each resolution; the PL-25-\(256^3\) and PL-50-\(512^3\) lines coincide because the two runs have the same particle mass. The gray ratio band marks \(\pm 10\%\). The same-volume comparisons test mass resolution, while the PL-50-\(512^3\) comparison gives a fixed-particle-mass volume check.}}{18}{figure.10}\protected@file@percent }
\newlabel{fig:fof_hmf_resolution}{{10}{18}{FOF halo-mass-function resolution and volume check for the PL simulations. Upper panels show the Warren-corrected FOF mass functions at \(z=0\) and \(z=8.52\) for the fiducial PL-25-\(1024^3\) run, same-volume lower-resolution PL-25-\(512^3\) and PL-25-\(256^3\) runs, and the larger PL-50-\(512^3\) run. Lower panels show ratios to PL-25-\(1024^3\) in the same mass bins. Vertical dotted lines mark the 50-particle FOF mass for each resolution; the PL-25-\(256^3\) and PL-50-\(512^3\) lines coincide because the two runs have the same particle mass. The gray ratio band marks \(\pm 10\%\). The same-volume comparisons test mass resolution, while the PL-50-\(512^3\) comparison gives a fixed-particle-mass volume check}{figure.10}{}}
\citation{BoylanKolchin2009MSII,Hellwing16cocoproject}
\@writefile{toc}{\contentsline {section}{\numberline {B}Temporary FOF Group Reassignment in Half-Mass Histories}{19}{section*.30}\protected@file@percent }
\newlabel{app:fof_gap_stitching}{{B}{19}{}{section*.30}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces PL half-mass assembly redshift under different treatments of temporary FOF group reassignment. All curves use the same \(z=0\) FOF halo sample and the same \textsc  {HBT-HERONS} \texttt  {TrackId} FOF mass histories; only the maximum number of consecutive non-FOF snapshots allowed for reconnection is varied. The strict \(N_{\rm  gap}=0\) case terminates a history once the object is temporarily classified as a satellite or hostless entry with zero FOF mass/size in its own catalog row. Increasing \(N_{\rm  gap}\) allows short FOF-zero episodes to be crossed, mimicking a simple fragmentation or temporary-reassignment correction. The lower panel shows the offset relative to the BK09 reference. The monotonic movement from the strict curve toward the all-gap curve shows that temporary assignment to another FOF group is a major source of the half-mass-history systematic.}}{20}{figure.11}\protected@file@percent }
\newlabel{fig:fof_gap_stitching}{{11}{20}{PL half-mass assembly redshift under different treatments of temporary FOF group reassignment. All curves use the same \(z=0\) FOF halo sample and the same \textsc {HBT-HERONS} \texttt {TrackId} FOF mass histories; only the maximum number of consecutive non-FOF snapshots allowed for reconnection is varied. The strict \(N_{\rm gap}=0\) case terminates a history once the object is temporarily classified as a satellite or hostless entry with zero FOF mass/size in its own catalog row. Increasing \(N_{\rm gap}\) allows short FOF-zero episodes to be crossed, mimicking a simple fragmentation or temporary-reassignment correction. The lower panel shows the offset relative to the BK09 reference. The monotonic movement from the strict curve toward the all-gap curve shows that temporary assignment to another FOF group is a major source of the half-mass-history systematic}{figure.11}{}}
\@writefile{toc}{\contentsline {section}{\numberline {C}Power-Spectrum Box-Size Reliability}{21}{section*.31}\protected@file@percent }
\newlabel{app:power_spectrum_reliability}{{C}{21}{}{section*.31}{}}
\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Fourier scales relevant for interpreting the power-spectrum validation plot. The fundamental mode is \(k_{\rm  fund}=2\pi /L_{\rm  box}\), and the mesh Nyquist scale is \(k_{\rm  Ny}=\pi N_{\rm  mesh}/L_{\rm  box}\) with \(N_{\rm  mesh}=1024\). The \(0.5k_{\rm  Ny}\) column is a conservative caution scale rather than a strict exclusion boundary; measurements between \(0.5k_{\rm  Ny}\) and \(k_{\rm  Ny}\) are shown to diagnose small-scale trends but are not used as precision-calibrated nonlinear-power measurements.}}{22}{table.3}\protected@file@percent }
\newlabel{tab:power_spectrum_reliability_ranges}{{III}{22}{Fourier scales relevant for interpreting the power-spectrum validation plot. The fundamental mode is \(k_{\rm fund}=2\pi /L_{\rm box}\), and the mesh Nyquist scale is \(k_{\rm Ny}=\pi N_{\rm mesh}/L_{\rm box}\) with \(N_{\rm mesh}=1024\). The \(0.5k_{\rm Ny}\) column is a conservative caution scale rather than a strict exclusion boundary; measurements between \(0.5k_{\rm Ny}\) and \(k_{\rm Ny}\) are shown to diagnose small-scale trends but are not used as precision-calibrated nonlinear-power measurements}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Simulation/theory validation of the nonlinear matter power spectrum for different box sizes. Upper panels show absolute spectra at four redshifts. The solid black curve is the PL nonlinear reference, and the dashed blue curve is the BT\_soft reference. Open symbols show measured spectra from PL boxes with \(L_{\rm  box}=25,128,256,\) and \(512\,h^{-1}{\rm  Mpc}\), and from BT\_soft boxes with \(L_{\rm  box}=2.5,5,25,\) and \(256\,h^{-1}{\rm  Mpc}\). Lower panels show the corresponding simulation/theory ratios: PL measurements are divided by the PL reference, while BT\_soft measurements are divided by the BT\_soft reference. Vertical dotted or dashed markers indicate the mesh Nyquist scales of the plotted boxes, and the gray shading marks the high-\(k\) caution region for the \(25\,h^{-1}{\rm  Mpc}\) box. The comparison is used to assign box-size-dependent reliability ranges; the large boxes anchor low and intermediate \(k\), while the smaller boxes are treated as high-\(k\) diagnostics.}}{22}{figure.12}\protected@file@percent }
\newlabel{fig:power_spectrum_validation_theory}{{12}{22}{Simulation/theory validation of the nonlinear matter power spectrum for different box sizes. Upper panels show absolute spectra at four redshifts. The solid black curve is the PL nonlinear reference, and the dashed blue curve is the BT\_soft reference. Open symbols show measured spectra from PL boxes with \(L_{\rm box}=25,128,256,\) and \(512\,h^{-1}{\rm Mpc}\), and from BT\_soft boxes with \(L_{\rm box}=2.5,5,25,\) and \(256\,h^{-1}{\rm Mpc}\). Lower panels show the corresponding simulation/theory ratios: PL measurements are divided by the PL reference, while BT\_soft measurements are divided by the BT\_soft reference. Vertical dotted or dashed markers indicate the mesh Nyquist scales of the plotted boxes, and the gray shading marks the high-\(k\) caution region for the \(25\,h^{-1}{\rm Mpc}\) box. The comparison is used to assign box-size-dependent reliability ranges; the large boxes anchor low and intermediate \(k\), while the smaller boxes are treated as high-\(k\) diagnostics}{figure.12}{}}
