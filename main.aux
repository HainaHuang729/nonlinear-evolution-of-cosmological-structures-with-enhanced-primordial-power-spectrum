\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces {\color  {blue}Spherical-overdensity halo mass function comparison using \(M_{200c}\) masses and the Bocquet16 fitting function. Symbols show the measured SOAP \(M_{200c}\) mass functions for PL, BT\_soft, and BT\_deep, while lines show the corresponding Bocquet16 predictions evaluated with each model's input power spectrum. The lower panels show the fractional difference relative to the Bocquet16 prediction.}}}{14}{figure.caption.41}\protected@file@percent }
\newlabel{fig:m200c_bocquet16_hmf}{{8}{14}{\color {blue}Spherical-overdensity halo mass function comparison using \(M_{200c}\) masses and the Bocquet16 fitting function. Symbols show the measured SOAP \(M_{200c}\) mass functions for PL, BT\_soft, and BT\_deep, while lines show the corresponding Bocquet16 predictions evaluated with each model's input power spectrum. The lower panels show the fractional difference relative to the Bocquet16 prediction}{figure.caption.41}{}}
