\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces {\color  {blue}Concentration--mass relations for the PL, BT\_soft ($k_p=1\,h\,\mathrm  {Mpc}^{-1}$, $m_s=1.5$), and BT\_deep ($k_p=10\,h\,\mathrm  {Mpc}^{-1}$, $m_s=1.5$) models at four representative redshifts. Symbols show the simulation measurements and solid curves show the corresponding semi-analytic predictions. Simulation points require \(N_{\rm  DM}\ge 100\), corresponding to \(M_{200c}\gtrsim 1.9\times 10^8\,M_\odot \). The dashed and dotted vertical markers show the 100-particle selection scale and the \(\simeq 500\)-particle scale near \(10^9\,M_\odot \), respectively; quantitative low-mass concentration claims are quoted above the latter scale. At $z=0$, the median concentration in the $10^9$--$10^{9.5}\,M_\odot $ bin is higher than PL by factors of $3.20$ and $1.35$ for the $k_p=1$ and $k_p=10$ runs, respectively.}}}{8}{figure.caption.26}\protected@file@percent }
\newlabel{fig:concentration_comparison}{{6}{8}{\color {blue}Concentration--mass relations for the PL, BT\_soft ($k_p=1\,h\,\mathrm {Mpc}^{-1}$, $m_s=1.5$), and BT\_deep ($k_p=10\,h\,\mathrm {Mpc}^{-1}$, $m_s=1.5$) models at four representative redshifts. Symbols show the simulation measurements and solid curves show the corresponding semi-analytic predictions. Simulation points require \(N_{\rm DM}\ge 100\), corresponding to \(M_{200c}\gtrsim 1.9\times 10^8\,M_\odot \). The dashed and dotted vertical markers show the 100-particle selection scale and the \(\simeq 500\)-particle scale near \(10^9\,M_\odot \), respectively; quantitative low-mass concentration claims are quoted above the latter scale. At $z=0$, the median concentration in the $10^9$--$10^{9.5}\,M_\odot $ bin is higher than PL by factors of $3.20$ and $1.35$ for the $k_p=1$ and $k_p=10$ runs, respectively}{figure.caption.26}{}}
\newlabel{fig:power_spectra_ratio_z0}{{7}{8}{}{figure.7}{}}
