\@writefile{toc}{\contentsline {subsection}{\numberline {B}Initial Conditions}{3}{section*.10}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces {\color  {blue}Input linear matter power spectra used to generate the PL, BT\_soft, and BT\_deep initial conditions. The PL spectrum provides the standard power-law baseline, while the BT spectra keep the large-scale normalization fixed and depart from PL only above their respective pivot scales. BT\_soft departs from PL over a broader range of mildly nonlinear modes, whereas BT\_deep confines the modification to smaller scales. The spectra are evaluated at the initial redshift, $z=200$. For the main $25\,h^{-1}\mathrm  {Mpc}$, $1024^3$ runs, the particle-grid Nyquist scale is \(k_{\rm  Ny}\simeq 129\,h\,\mathrm  {Mpc}^{-1}\).}}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:power_spectrum_comparison}{{1}{3}{\color {blue}Input linear matter power spectra used to generate the PL, BT\_soft, and BT\_deep initial conditions. The PL spectrum provides the standard power-law baseline, while the BT spectra keep the large-scale normalization fixed and depart from PL only above their respective pivot scales. BT\_soft departs from PL over a broader range of mildly nonlinear modes, whereas BT\_deep confines the modification to smaller scales. The spectra are evaluated at the initial redshift, $z=200$. For the main $25\,h^{-1}\mathrm {Mpc}$, $1024^3$ runs, the particle-grid Nyquist scale is \(k_{\rm Ny}\simeq 129\,h\,\mathrm {Mpc}^{-1}\)}{figure.1}{}}
