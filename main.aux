\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces {\color  {blue}Spherical-overdensity halo mass function comparison using \(M_{200c}\) masses and the B16 fitting function. Symbols show the measured SOAP \(M_{200c}\) mass functions for PL, BT\_soft, and BT\_deep, while lines show the corresponding B16 predictions evaluated with each model's input power spectrum. The SOAP catalog cut is \(N_{\rm  DM}\ge 100\), and the plotted bins require \(M_{200c}\ge 2.0\times 10^8\,M_\odot \), close to the 100-particle scale \(1.9\times 10^8\,M_\odot \). The lower panels show the fractional difference relative to the B16 prediction.}\relax }}{15}{figure.caption.37}\protected@file@percent }
\newlabel{fig:m200c_bocquet16_hmf}{{8}{15}{{\color {blue}Spherical-overdensity halo mass function comparison using \(M_{200c}\) masses and the B16 fitting function. Symbols show the measured SOAP \(M_{200c}\) mass functions for PL, BT\_soft, and BT\_deep, while lines show the corresponding B16 predictions evaluated with each model's input power spectrum. The SOAP catalog cut is \(N_{\rm DM}\ge 100\), and the plotted bins require \(M_{200c}\ge 2.0\times 10^8\,M_\odot \), close to the 100-particle scale \(1.9\times 10^8\,M_\odot \). The lower panels show the fractional difference relative to the B16 prediction.}\relax }{figure.caption.37}{}}
\HyPL@Entry{15<</P(\376\377\0001\0006)>>}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces {\color  {blue}PL half-mass assembly redshift under different treatments of temporary FOF group reassignment. All curves use the same \(z=0\) FOF halo sample and the same HBT+ \texttt  {TrackId} FOF mass histories; only the maximum number of consecutive non-FOF snapshots allowed for reconnection is varied. The strict \(N_{\rm  gap}=0\) case terminates a history once the object is temporarily classified as a satellite or hostless entry with zero FOF mass/size in its own catalog row. Increasing \(N_{\rm  gap}\) allows short FOF-zero episodes to be crossed, mimicking a simple fragmentation or temporary-reassignment correction. The lower panel shows the offset relative to the BK09 reference. The monotonic movement from the strict curve toward the all-gap curve shows that temporary assignment to another FOF group is a major source of the half-mass-history systematic.}\relax }}{16}{figure.caption.39}\protected@file@percent }
\newlabel{fig:fof_gap_stitching}{{9}{16}{{\color {blue}PL half-mass assembly redshift under different treatments of temporary FOF group reassignment. All curves use the same \(z=0\) FOF halo sample and the same HBT+ \texttt {TrackId} FOF mass histories; only the maximum number of consecutive non-FOF snapshots allowed for reconnection is varied. The strict \(N_{\rm gap}=0\) case terminates a history once the object is temporarily classified as a satellite or hostless entry with zero FOF mass/size in its own catalog row. Increasing \(N_{\rm gap}\) allows short FOF-zero episodes to be crossed, mimicking a simple fragmentation or temporary-reassignment correction. The lower panel shows the offset relative to the BK09 reference. The monotonic movement from the strict curve toward the all-gap curve shows that temporary assignment to another FOF group is a major source of the half-mass-history systematic.}\relax }{figure.caption.39}{}}
