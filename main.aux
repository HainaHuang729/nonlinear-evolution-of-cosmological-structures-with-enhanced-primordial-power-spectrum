\@writefile{toc}{\contentsline {section}{\numberline {A}Temporary FOF Group Reassignment in Half-Mass Histories}{18}{section*.167}\protected@file@percent }
\newlabel{app:fof_gap_stitching}{{A}{18}{}{section*.167}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces PL half-mass assembly redshift under different treatments of temporary FOF group reassignment. All curves use the same \(z=0\) FOF halo sample and the same \textsc  {HBT-HERONS} \texttt  {TrackId} FOF mass histories; only the maximum number of consecutive non-FOF snapshots allowed for reconnection is varied. The strict \(N_{\rm  gap}=0\) case terminates a history once the object is temporarily classified as a satellite or hostless entry with zero FOF mass/size in its own catalog row. Increasing \(N_{\rm  gap}\) allows short FOF-zero episodes to be crossed, mimicking a simple fragmentation or temporary-reassignment correction. The lower panel shows the offset relative to the BK09 reference. The monotonic movement from the strict curve toward the all-gap curve shows that temporary assignment to another FOF group is a major source of the half-mass-history systematic.}}{19}{figure.9}\protected@file@percent }
\newlabel{fig:fof_gap_stitching}{{9}{19}{PL half-mass assembly redshift under different treatments of temporary FOF group reassignment. All curves use the same \(z=0\) FOF halo sample and the same \textsc {HBT-HERONS} \texttt {TrackId} FOF mass histories; only the maximum number of consecutive non-FOF snapshots allowed for reconnection is varied. The strict \(N_{\rm gap}=0\) case terminates a history once the object is temporarily classified as a satellite or hostless entry with zero FOF mass/size in its own catalog row. Increasing \(N_{\rm gap}\) allows short FOF-zero episodes to be crossed, mimicking a simple fragmentation or temporary-reassignment correction. The lower panel shows the offset relative to the BK09 reference. The monotonic movement from the strict curve toward the all-gap curve shows that temporary assignment to another FOF group is a major source of the half-mass-history systematic}{figure.9}{}}
