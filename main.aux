\@writefile{loc}{\contentsline {added}{Added~(rev): \truncate {\Changestruncatewidth }{The initial redshift \(z_i=200\) enters later, when this template is converted into the input linear matter power spectrum used by the initial-condition generator.}}{3}{section*.27}\protected@file@percent }
\@writefile{loc}{\contentsline {replaced}{Replaced~(rev): \truncate {\Changestruncatewidth }{In the initial-condition calculation, we implement this target by modifying the transfer function used in the power-spectrum calculation. The generated input linear matter power spectrum at \(z_i=200\), \(P_{\rm  lin}\propto T^2(k)k^{n_s}\), then carries the corresponding small-scale enhancement above \(k_p\).}}{3}{section*.28}\protected@file@percent }
