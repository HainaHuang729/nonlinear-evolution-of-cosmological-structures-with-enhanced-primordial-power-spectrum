\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces {\color  {blue}Projected dark matter density fields for the PL, BT\_soft, and BT\_deep simulations at $z=0$. All three runs use a periodic box of $25\,h^{-1}\,\mathrm  {Mpc}$ with $1024^3$ particles. The figure is used as a visual comparison of the dark matter field; quantitative claims in this paper are based on the halo mass function, assembly histories, density profiles, concentration--mass relation, and matter power spectrum rather than on projected substructure counts.}}}{7}{figure.caption.21}\protected@file@percent }
\newlabel{fig:dark_matter_comparison}{{4}{7}{\color {blue}Projected dark matter density fields for the PL, BT\_soft, and BT\_deep simulations at $z=0$. All three runs use a periodic box of $25\,h^{-1}\,\mathrm {Mpc}$ with $1024^3$ particles. The figure is used as a visual comparison of the dark matter field; quantitative claims in this paper are based on the halo mass function, assembly histories, density profiles, concentration--mass relation, and matter power spectrum rather than on projected substructure counts}{figure.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Halo Mass Function Comparison Across Cosmological Models and Redshifts. The main-text comparison uses FOF halo masses and the Reed07 FOF fitting function. Each panel shows $dn/d\ln M_{\rm  FOF}$ as a function of halo mass at a representative redshift. The simulation data are shown as symbols with Poisson error bars, and the matching Reed07 predictions are shown as lines using the same model colors. {\color  {blue}Here BT\_soft denotes the model with $k_p=1\,h\,{\rm  Mpc}^{-1}$ and $m_s=1.5$, while BT\_deep denotes the model with $k_p=10\,h\,{\rm  Mpc}^{-1}$ and $m_s=1.5$.} All simulations use a $25\,h^{-1}{\rm  Mpc}$ box with $1024^3$ particles. The corresponding $M_{200c}$ comparison with Bocquet16 is moved to Appendix~\ref {app:m200c_hmf}. {\color  {red} In general, we should be more clear about the kp and ms in the plot. What is the kp and ms here? the legend is wrong?} {\color  {red} we should focus more on high redshift. We can delete z=0.42, 1.51, 2.67 and add z=10, 15, 20}}}{8}{figure.caption.23}\protected@file@percent }
\newlabel{fig:mass_function}{{5}{8}{Halo Mass Function Comparison Across Cosmological Models and Redshifts. The main-text comparison uses FOF halo masses and the Reed07 FOF fitting function. Each panel shows $dn/d\ln M_{\rm FOF}$ as a function of halo mass at a representative redshift. The simulation data are shown as symbols with Poisson error bars, and the matching Reed07 predictions are shown as lines using the same model colors. {\color {blue}Here BT\_soft denotes the model with $k_p=1\,h\,{\rm Mpc}^{-1}$ and $m_s=1.5$, while BT\_deep denotes the model with $k_p=10\,h\,{\rm Mpc}^{-1}$ and $m_s=1.5$.} All simulations use a $25\,h^{-1}{\rm Mpc}$ box with $1024^3$ particles. The corresponding $M_{200c}$ comparison with Bocquet16 is moved to Appendix~\ref {app:m200c_hmf}. {\color {red} In general, we should be more clear about the kp and ms in the plot. What is the kp and ms here? the legend is wrong?} {\color {red} we should focus more on high redshift. We can delete z=0.42, 1.51, 2.67 and add z=10, 15, 20}}{figure.caption.23}{}}
