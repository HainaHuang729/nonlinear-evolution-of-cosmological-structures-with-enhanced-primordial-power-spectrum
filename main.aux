\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Summary of cosmological $N$-body simulation parameters. The main comparison uses the PL, BT\_soft, and BT\_deep runs with identical box size, particle number, particle mass, and force softening. Additional BT variants explore stronger tilts or smaller boxes, while the PL resolution and volume tests provide numerical reference cases. Here $k_p$ is the wavenumber where the primordial spectrum changes slope, $m_s$ is the small-scale spectral index, $N$ is the number of dark matter particles, $m_{\text  {DM}}$ is the particle mass, and $\epsilon $ is the gravitational softening length.}}{4}{table.caption.11}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:simulation_parameters}{{I}{4}{Summary of cosmological $N$-body simulation parameters. The main comparison uses the PL, BT\_soft, and BT\_deep runs with identical box size, particle number, particle mass, and force softening. Additional BT variants explore stronger tilts or smaller boxes, while the PL resolution and volume tests provide numerical reference cases. Here $k_p$ is the wavenumber where the primordial spectrum changes slope, $m_s$ is the small-scale spectral index, $N$ is the number of dark matter particles, $m_{\text {DM}}$ is the particle mass, and $\epsilon $ is the gravitational softening length}{table.caption.11}{}}
