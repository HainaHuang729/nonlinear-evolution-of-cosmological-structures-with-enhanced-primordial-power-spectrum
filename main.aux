\citation{Eisenstein1998}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textcolor {blue}{Half-mass assembly redshift $z_{1/2}$ as a function of halo mass at $z=0$ for the PL, BT\_soft, and BT\_deep simulations. Each point gives the mean $z_{1/2}$ of halos in a mass bin, where $z_{1/2}$ is defined from the main progenitor branch of the merger tree; error bars indicate the standard deviation within the bin. Halos in the blue-tilted models reach half of their final mass systematically earlier than their PL counterparts, especially at intermediate masses.}}}{8}{figure.caption.24}\protected@file@percent }
\newlabel{fig:half_mass_redshift}{{4}{8}{\blue {Half-mass assembly redshift $z_{1/2}$ as a function of halo mass at $z=0$ for the PL, BT\_soft, and BT\_deep simulations. Each point gives the mean $z_{1/2}$ of halos in a mass bin, where $z_{1/2}$ is defined from the main progenitor branch of the merger tree; error bars indicate the standard deviation within the bin. Halos in the blue-tilted models reach half of their final mass systematically earlier than their PL counterparts, especially at intermediate masses.}}{figure.caption.24}{}}
\newlabel{subsub:concentration}{{IV\,E\,2}{8}{}{section*.28}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {2}Concentration-Mass Relation}{8}{section*.28}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textcolor {blue}{Stacked halo density profiles for the PL, BT\_soft, and BT\_deep models in a sequence of halo-mass bins. Radii are normalized by $R_{200}$, and each panel compares halos within a narrow mass interval. Relative to PL, the blue-tilted models exhibit higher central densities, with the strongest effect appearing in the low- and intermediate-mass regimes.}}}{9}{figure.caption.27}\protected@file@percent }
\newlabel{fig:halo_density_analysis}{{5}{9}{\blue {Stacked halo density profiles for the PL, BT\_soft, and BT\_deep models in a sequence of halo-mass bins. Radii are normalized by $R_{200}$, and each panel compares halos within a narrow mass interval. Relative to PL, the blue-tilted models exhibit higher central densities, with the strongest effect appearing in the low- and intermediate-mass regimes.}}{figure.caption.27}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textcolor {blue}{Concentration--mass relations for the PL, BT\_soft ($k_p=1\,h\,\mathrm  {Mpc}^{-1}$, $m_s=1.5$), and BT\_deep ($k_p=10\,h\,\mathrm  {Mpc}^{-1}$, $m_s=1.5$) models at four representative redshifts. Symbols show the simulation measurements and solid curves show the corresponding semi-analytic predictions. The lower panels give the concentration ratios relative to the PL model. At fixed mass, halos in the blue-tilted models are systematically more concentrated, with the strongest differences occurring in the low-mass regime.}}}{10}{figure.caption.29}\protected@file@percent }
\newlabel{fig:concentration_comparison}{{6}{10}{\blue {Concentration--mass relations for the PL, BT\_soft ($k_p=1\,h\,\mathrm {Mpc}^{-1}$, $m_s=1.5$), and BT\_deep ($k_p=10\,h\,\mathrm {Mpc}^{-1}$, $m_s=1.5$) models at four representative redshifts. Symbols show the simulation measurements and solid curves show the corresponding semi-analytic predictions. The lower panels give the concentration ratios relative to the PL model. At fixed mass, halos in the blue-tilted models are systematically more concentrated, with the strongest differences occurring in the low-mass regime.}}{figure.caption.29}{}}
