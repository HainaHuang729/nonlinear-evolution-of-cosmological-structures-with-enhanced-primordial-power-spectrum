\newlabel{sec:discussion}{{V}{13}{}{section*.129}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {A}Physical Interpretation of the Main Trends}{13}{section*.130}\protected@file@percent }
\@writefile{loc}{\contentsline {replaced}{Replaced~(rev): \truncate {\Changestruncatewidth }{results in Section~\ref {sec:results} are consistent with the following physical picture}}{13}{section*.131}\protected@file@percent }
\@writefile{loc}{\contentsline {replaced}{Replaced~(rev): \truncate {\Changestruncatewidth }{Enhancing the small-scale primordial power spectrum raises the amplitude of the corresponding small-scale density fluctuations in the initial conditions. In the BT runs, these stronger initial fluctuations tend to collapse earlier than in PL. The earliest visible effect is a high-redshift excess of low-mass halos; at later times, the same trend appears in earlier assembly times and higher concentrations.}}{13}{section*.132}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Nonlinear matter power spectra and matched BT/PL response ratios at representative redshifts. The upper panels show PL and BT spectra for the \(k_p=1\) and \(k_p=10\), \(m_s=1.5\) variants in the matched \(25\) and \(256\,h^{-1}\mathrm  {Mpc}\) boxes, together with the corresponding nonlinear theory curves for orientation. The lower panels show the direct simulation ratios BT/PL for each matched box and \(k_p\), plus the corresponding BT-theory/PL-theory ratios. In the fiducial $k_p=1$, $25\,h^{-1}\,\mathrm  {Mpc}$ box at $z=0$, BT/PL reaches $1.17$ at $k=20\,h\,\mathrm  {Mpc}^{-1}$ and $1.34$ at $k=40\,h\,\mathrm  {Mpc}^{-1}$. The spectra are measured on \(1024^3\) meshes. Vertical markers show the mesh Nyquist scales for the \(256\) and \(25\,h^{-1}\mathrm  {Mpc}\) boxes. Quantitative interpretation of the \(256\,h^{-1}\mathrm  {Mpc}\) comparison is restricted to \(k\le k_{\rm  Ny}\simeq 12.6\,h\,\mathrm  {Mpc}^{-1}\). \replaced [id=rev]{The fiducial 25-box high-\(k\) points remain below its mesh Nyquist frequency \(k_{\rm  Ny}\simeq 129\,h\,\mathrm  {Mpc}^{-1}\), but they are used only as checks of the small-scale trend because their amplitude is sensitive to the power-spectrum estimator.}{The fiducial 25-box high-\(k\) points remain below its mesh Nyquist frequency \(k_{\rm  Ny}\simeq 129\,h\,\mathrm  {Mpc}^{-1}\) but are treated as estimator-sensitive field-level checks.} The gray high-\(k\) region marks scales beyond the 25-box Nyquist frequency, and the shaded band around unity in the ratio panels marks a \(\pm 10\%\) reference interval.}}{14}{figure.8}\protected@file@percent }
\@writefile{loc}{\contentsline {replaced}{Replaced~(rev): \truncate {\Changestruncatewidth }{The fiducial 25-box high-\(k\) points remain below its mesh Nyquist frequency \(k_{\rm  Ny}\simeq 129\,h\,\mathrm  {Mpc}^{-1}\), but they are used only as checks of the small-scale trend because their amplitude is sensitive to the power-spectrum estimator.}}{14}{section*.128}\protected@file@percent }
\newlabel{fig:power_spectra_ratio_z0}{{8}{14}{Nonlinear matter power spectra and matched BT/PL response ratios at representative redshifts. The upper panels show PL and BT spectra for the \(k_p=1\) and \(k_p=10\), \(m_s=1.5\) variants in the matched \(25\) and \(256\,h^{-1}\mathrm {Mpc}\) boxes, together with the corresponding nonlinear theory curves for orientation. The lower panels show the direct simulation ratios BT/PL for each matched box and \(k_p\), plus the corresponding BT-theory/PL-theory ratios. In the fiducial $k_p=1$, $25\,h^{-1}\,\mathrm {Mpc}$ box at $z=0$, BT/PL reaches $1.17$ at $k=20\,h\,\mathrm {Mpc}^{-1}$ and $1.34$ at $k=40\,h\,\mathrm {Mpc}^{-1}$. The spectra are measured on \(1024^3\) meshes. Vertical markers show the mesh Nyquist scales for the \(256\) and \(25\,h^{-1}\mathrm {Mpc}\) boxes. Quantitative interpretation of the \(256\,h^{-1}\mathrm {Mpc}\) comparison is restricted to \(k\le k_{\rm Ny}\simeq 12.6\,h\,\mathrm {Mpc}^{-1}\). \revisionreplace {The fiducial 25-box high-\(k\) points remain below its mesh Nyquist frequency \(k_{\rm Ny}\simeq 129\,h\,\mathrm {Mpc}^{-1}\), but they are used only as checks of the small-scale trend because their amplitude is sensitive to the power-spectrum estimator.}{The fiducial 25-box high-\(k\) points remain below its mesh Nyquist frequency \(k_{\rm Ny}\simeq 129\,h\,\mathrm {Mpc}^{-1}\) but are treated as estimator-sensitive field-level checks.} The gray high-\(k\) region marks scales beyond the 25-box Nyquist frequency, and the shaded band around unity in the ratio panels marks a \(\pm 10\%\) reference interval}{section*.128}{}}
