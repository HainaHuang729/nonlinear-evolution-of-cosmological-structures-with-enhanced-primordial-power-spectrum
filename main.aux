\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces {\color  {blue}Projected dark matter density fields for the PL, BT\_soft, and BT\_deep simulations at $z=0$. All three runs use a periodic box of $25\,h^{-1}\,\mathrm  {Mpc}$ with $1024^3$ particles. The figure is used as a visual comparison of the dark matter field; quantitative claims in this paper are based on the halo mass function, assembly histories, density profiles, concentration--mass relation, and matter power spectrum rather than on projected substructure counts.}}}{5}{figure.caption.19}\protected@file@percent }
\newlabel{fig:dark_matter_comparison}{{2}{5}{\color {blue}Projected dark matter density fields for the PL, BT\_soft, and BT\_deep simulations at $z=0$. All three runs use a periodic box of $25\,h^{-1}\,\mathrm {Mpc}$ with $1024^3$ particles. The figure is used as a visual comparison of the dark matter field; quantitative claims in this paper are based on the halo mass function, assembly histories, density profiles, concentration--mass relation, and matter power spectrum rather than on projected substructure counts}{figure.caption.19}{}}
