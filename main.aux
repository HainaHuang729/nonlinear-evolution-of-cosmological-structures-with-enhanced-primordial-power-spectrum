\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces {\color  {blue}Half-mass assembly redshift \(z_{1/2}\) as a function of final FOF mass \(M_{\rm  FOF}\) at \(z=0\) for the PL, BT\_soft, and BT\_deep simulations. The points use raw same-\texttt  {TrackId} FOF histories: for each present-day FOF halo, we follow the same HBT+ \texttt  {TrackId} over snapshots 0021--0056 and measure \(z_{1/2}\) only when two adjacent detections bracket \(M_0/2\). No gap filling or cumulative maximum envelope is applied. The plotted values are the mean individual-halo \(z_{1/2}\) in each mass bin, and the error bars show the 16th--84th percentile halo-to-halo range. The black and gray curves show the BK09 and COCO/Hellwing16 reference relations, respectively \citep  {BoylanKolchin2009MSII,Hellwing16cocoproject}; the lower panel shows the difference relative to BK09. The HBT+ catalogs retain halos with at least 20 particles, corresponding to \(M\simeq 3.8\times 10^7\,M_\odot \) in the main runs; the quoted low-mass trends near \(10^9\,M_\odot \) are therefore based on halos with \(\gtrsim 5\times 10^2\) particles at \(z=0\). Under this common no-envelope diagnostic, PL is close to the reference relations while the blue-tilted models assemble earlier, with the strongest shift in BT\_soft.}\relax }}{8}{figure.caption.21}\protected@file@percent }
\newlabel{fig:half_mass_redshift}{{4}{8}{{\color {blue}Half-mass assembly redshift \(z_{1/2}\) as a function of final FOF mass \(M_{\rm FOF}\) at \(z=0\) for the PL, BT\_soft, and BT\_deep simulations. The points use raw same-\texttt {TrackId} FOF histories: for each present-day FOF halo, we follow the same HBT+ \texttt {TrackId} over snapshots 0021--0056 and measure \(z_{1/2}\) only when two adjacent detections bracket \(M_0/2\). No gap filling or cumulative maximum envelope is applied. The plotted values are the mean individual-halo \(z_{1/2}\) in each mass bin, and the error bars show the 16th--84th percentile halo-to-halo range. The black and gray curves show the BK09 and COCO/Hellwing16 reference relations, respectively \citep {BoylanKolchin2009MSII,Hellwing16cocoproject}; the lower panel shows the difference relative to BK09. The HBT+ catalogs retain halos with at least 20 particles, corresponding to \(M\simeq 3.8\times 10^7\,M_\odot \) in the main runs; the quoted low-mass trends near \(10^9\,M_\odot \) are therefore based on halos with \(\gtrsim 5\times 10^2\) particles at \(z=0\). Under this common no-envelope diagnostic, PL is close to the reference relations while the blue-tilted models assemble earlier, with the strongest shift in BT\_soft.}\relax }{figure.caption.21}{}}
