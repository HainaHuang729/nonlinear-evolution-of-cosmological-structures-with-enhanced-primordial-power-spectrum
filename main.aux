\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textcolor {blue}{Nonlinear matter power spectra at $z=0$ for the PL, BT\_soft, and BT\_deep models. The upper panel shows the dimensionless power spectrum $\Delta ^2(k)$, while the lower panels give the ratios of the blue-tilted models relative to PL. In both BT cases, the excess primordial small-scale power is converted into an enhancement of nonlinear clustering at large $k$, with the magnitude of the effect depending on the pivot scale of the initial spectrum.}}}{12}{figure.caption.31}\protected@file@percent }
\newlabel{fig:power_spectra_ratio_z0}{{7}{12}{\blue {Nonlinear matter power spectra at $z=0$ for the PL, BT\_soft, and BT\_deep models. The upper panel shows the dimensionless power spectrum $\Delta ^2(k)$, while the lower panels give the ratios of the blue-tilted models relative to PL. In both BT cases, the excess primordial small-scale power is converted into an enhancement of nonlinear clustering at large $k$, with the magnitude of the effect depending on the pivot scale of the initial spectrum.}}{figure.caption.31}{}}
