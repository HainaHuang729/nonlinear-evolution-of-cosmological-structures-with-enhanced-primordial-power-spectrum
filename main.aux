\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces {\color  {blue}Nonlinear matter power spectra at $z=0$ for the PL and blue-tilted simulation products used in this analysis. The upper panel shows the dimensionless power spectrum $\Delta ^2(k)$, while the lower panels give ratios relative to PL. For the $k_p=1$ comparison in the fiducial $25\,h^{-1}\,\mathrm  {Mpc}$ box, the ratio is close to unity at $k\lesssim 2\,h\,\mathrm  {Mpc}^{-1}$ and rises to $1.17$ at $k=20\,h\,\mathrm  {Mpc}^{-1}$ and $1.34$ at $k=40\,h\,\mathrm  {Mpc}^{-1}$.}}}{11}{figure.caption.30}\protected@file@percent }
\newlabel{fig:power_spectra_ratio_z0}{{7}{11}{\color {blue}Nonlinear matter power spectra at $z=0$ for the PL and blue-tilted simulation products used in this analysis. The upper panel shows the dimensionless power spectrum $\Delta ^2(k)$, while the lower panels give ratios relative to PL. For the $k_p=1$ comparison in the fiducial $25\,h^{-1}\,\mathrm {Mpc}$ box, the ratio is close to unity at $k\lesssim 2\,h\,\mathrm {Mpc}^{-1}$ and rises to $1.17$ at $k=20\,h\,\mathrm {Mpc}^{-1}$ and $1.34$ at $k=40\,h\,\mathrm {Mpc}^{-1}$}{figure.caption.30}{}}
